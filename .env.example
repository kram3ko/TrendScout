# Copy to .env before the first `docker compose up --build`.
# Every value below has a working default: the stack starts as-is.

# --- Web ---
APP_PORT=8080

# --- Database ---
POSTGRES_USER=trendscout
POSTGRES_PASSWORD=trendscout
POSTGRES_DB=trendscout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (Taskiq broker + result backend) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=720
# Set to true once the panel is served over HTTPS.
COOKIE_SECURE=false

# Seeded automatically on startup — these are the panel credentials.
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=admin123

# --- LLM scoring ---
# Provider: gemini | anthropic | openai | none
# An empty key means the deterministic formula: the stack still starts and scores.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_BATCH_SIZE=10

# --- Scraping ---
AMAZON_MAX_ITEMS_PER_CATEGORY=30
SCRAPE_INTERVAL_HOURS=6
TRENDS_GEO=US
TRENDS_MAX_PRODUCTS_PER_RUN=20

# --- CORS (only needed for the Vite dev server; production is same-origin) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
